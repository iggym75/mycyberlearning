{
  "name": "mycyberlearning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My Cyber Learning: curated cybersecurity podcasts and books (mycyberlearning.co.uk)",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply mycyberlearning --remote",
    "seed": "node scripts/seed.mjs",
    "refresh": "node scripts/refresh.mjs",
    "refresh:dry": "node scripts/refresh.mjs --dry-run --limit 5",
    "export": "node scripts/export.mjs",
    "test": "node --no-warnings --test scripts/test/*.test.mjs",
    "import:books": "node scripts/import-books.mjs",
    "news": "node scripts/news.mjs",
    "news:dry": "node scripts/news.mjs --dry-run --local",
    "send": "node scripts/send-digest.mjs",
    "send:preview": "node scripts/send-digest.mjs --preview"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
