// My Cyber Learning: Cloudflare Worker configuration (Workers Free plan; no payment method needed).
// Deploy:  npx wrangler deploy   (GitHub Actions does this on every push to main)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycyberlearning",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static site built by `npm run build`. The Worker only runs for the dynamic paths below.
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/admin"]
  },

  // Create once with:  npx wrangler d1 create mycyberlearning --jurisdiction eu
  // then paste the database_id it prints here (it's an identifier, not a secret).
  "d1_databases": [
    { "binding": "DB", "database_name": "mycyberlearning", "database_id": "427380a3-04e5-4705-96fd-dbd17af339ac", "migrations_dir": "worker/migrations" }
  ],

  // Non-secret settings. Secrets are set with `npx wrangler secret put NAME` (see the runbook):
  //   TOKEN_SECRET, SESSION_SECRET, VOTE_SALT, MAIL_API_KEY, GITHUB_OAUTH_CLIENT_SECRET, ANTHROPIC_API_KEY (optional)
  "vars": {
    "SITE_URL": "https://mycyberlearning.co.uk",
    "MAIL_FROM": "My Cyber Learning <briefing@mycyberlearning.co.uk>",
    "MAIL_PROVIDER": "resend",
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liBFSHlciUM04fQn",
    "ADMIN_GITHUB_IDS": "281173996"
  },

  // Our own console messages only: request URLs (which carry unsubscribe tokens) and IP metadata aren't logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // Shared per-IP limit for briefing sign-ups (free; works across Cloudflare's isolates). Period must be 10 or 60 s.
  "ratelimits": [ { "name": "SUBSCRIBE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } } ],
  // The site's own domain (runbook Phase 6). Cloudflare creates the DNS record and certificate on deploy.
  "routes": [ { "pattern": "mycyberlearning.co.uk", "custom_domain": true } ],
  "workers_dev": false,  // the site is served only at mycyberlearning.co.uk (runbook Phase 6)
  "preview_urls": false
}
